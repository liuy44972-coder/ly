# 复制为 .env.<profile>（profile 由 TEST_PROFILE 指定，如 dev、test），并填入真实值。
# 所有值都是占位示例，禁止提交真实环境地址与凭据。
TEST_ENV=dev
API_BASE_URL=https://your-test-host.example.com
CLIENT_VERSION=0.0.0
CLIENT_COMMIT=0
API_VERSION=0
# 登录态凭据：填 Cookie 值（token=...）或纯 token，脚本会统一补 token= 前缀。
API_TOKEN=
TEST_TIMEOUT_MS=5000
# 需要登录态用例时设为 true，selfcheck 才会自动登录（会改动测试账号最后登录设备）。
SELFCHECK_LOGIN=false
